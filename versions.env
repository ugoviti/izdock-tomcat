# com.mysql:mysql-connector-j - https://dev.mysql.com/downloads/connector/j
# pin to 8.2.0 (uncomment, then tools/make-updates.sh --apply): applications hit by
# "[IDVariant::convertObject] Cannot convert from class: java.time.LocalDateTime" with newer drivers
#MYSQL_JDBC_PIN=8.2.0
MYSQL_JDBC_VER=8.4.0
MYSQL_JDBC_SHA256=d77962877d010777cff997015da90ee689f0f4bb76848340e1488f2b83332af5
