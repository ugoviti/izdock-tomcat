#!/usr/bin/env bash
# pre-commit hook: lint (shellcheck, hadolint) then gitleaks, which blocks commits
# that add secrets or private infrastructure references.
#
# enable once per clone:  git config core.hooksPath .githooks
# private extra rules:    ~/.config/gitleaks/izdock.toml (outside the repo, [extend] path = ".gitleaks.toml", same content as the
#                         Gitea secret GITLEAKS_CONFIG). Override path with GITLEAKS_IZDOCK_CONFIG.
# bypass (emergency only): git commit --no-verify
#
# gitleaks version and checksum are read from .gitea/actions/gitleaks/action.yml (single source of truth).
# If gitleaks is not in PATH, the pinned release is downloaded and verified into ~/.cache/gitleaks.
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
WORKFLOW="$ROOT/.gitea/actions/gitleaks/action.yml"
CONFIG="${GITLEAKS_IZDOCK_CONFIG:-$HOME/.config/gitleaks/izdock.toml}"

wf_env() { sed -n "s/^ *$1: *//p" "$WORKFLOW" | head -1 | tr -d "'\" "; }

find_gitleaks() {
  local ver sha dir tgz
  ver=$(wf_env GITLEAKS_VERSION)
  sha=$(wf_env GITLEAKS_SHA256)
  dir="${XDG_CACHE_HOME:-$HOME/.cache}/gitleaks/$ver"
  if [ -x "$dir/gitleaks" ]; then echo "$dir/gitleaks"; return; fi
  if [ "$(uname -s)-$(uname -m)" = "Linux-x86_64" ]; then
    tgz="gitleaks_${ver}_linux_x64.tar.gz"
    mkdir -p "$dir"
    echo "gitleaks: downloading v$ver..." >&2
    curl -fsSL -o "$dir/$tgz" "https://github.com/gitleaks/gitleaks/releases/download/v${ver}/${tgz}"
    echo "$sha  $dir/$tgz" | sha256sum -c --quiet - >&2
    tar xzf "$dir/$tgz" -C "$dir" gitleaks && rm -f "$dir/$tgz"
    echo "$dir/gitleaks"; return
  fi
  command -v gitleaks || true
}

# lint first: tools/lint.sh runs the pinned shellcheck and hadolint
if [ -x "$ROOT/tools/lint.sh" ]; then
  "$ROOT/tools/lint.sh" || { echo "lint: commit blocked, fix the findings above" >&2; exit 1; }
fi

GITLEAKS=$(find_gitleaks)
if [ -z "$GITLEAKS" ]; then
  echo "gitleaks: not available, commit blocked. Install gitleaks or use 'git commit --no-verify' at your own risk." >&2
  exit 1
fi

ARGS=(git --pre-commit --staged --redact --verbose --no-banner)
if [ -f "$CONFIG" ]; then
  ARGS+=(--config "$CONFIG")
elif [ -f "$ROOT/.gitleaks.toml" ]; then
  echo "gitleaks: WARNING private rules not found ($CONFIG), using .gitleaks.toml only" >&2
  ARGS+=(--config "$ROOT/.gitleaks.toml")
else
  echo "gitleaks: WARNING private rules not found ($CONFIG), using default rules only" >&2
fi

exec "$GITLEAKS" "${ARGS[@]}" "$ROOT"
